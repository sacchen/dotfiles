# Copy to ~/.ssh/config and customize for your machines.
# Keep real hostnames/IPs and usernames private when using a public repo.

Host *
  AddKeysToAgent yes
  UseKeychain yes
  IdentitiesOnly yes
  ServerAliveInterval 60
  ServerAliveCountMax 3

# Example host entry:
# Host my-server
#   HostName 203.0.113.10
#   User ubuntu
#   IdentityFile ~/.ssh/id_ed25519
